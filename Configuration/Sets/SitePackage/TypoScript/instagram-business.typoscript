# ==============================================
# FE-Plugin configuration for EXT:instagram
# ==============================================
plugin {
  tx_instagram {
    view {
      templateRootPaths {
        0 = EXT:bdp_template/Resources/Private/InstagramBusiness/Templates/
      }
      partialRootPaths {
        0 = EXT:bdp_template/Resources/Private/InstagramBusiness/Partials/
      }
      layoutRootPaths {
        0 = EXT:bdp_template/Resources/Private/InstagramBusiness/Layouts/
      }
    }
  }
}
