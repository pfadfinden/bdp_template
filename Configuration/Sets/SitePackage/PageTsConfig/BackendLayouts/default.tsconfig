#
# BACKENDLAYOUT: DEFAULT
#
mod {
    web_layout {
        BackendLayouts {
            default {
                title = LLL:EXT:bdp_template/Resources/Private/Language/locallang_be.xlf:backend_layout.default
                config {
                    backend_layout {
                        colCount = 1
                        rowCount = 2
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:bdp_template/Resources/Private/Language/locallang_be.xlf:backend_layout.column.header
                                        colPos = 5
                                        identifier = header
                                        allowed {
                                            CType = pfadfinden_headearslider, pfadfinden_headerblock
                                        }
                                        maxitems = 1
                                    }
                                }
                            }
                            2 {
                                columns {
                                    1 {
                                        name = LLL:EXT:bdp_template/Resources/Private/Language/locallang_be.xlf:backend_layout.column.normal
                                        colPos = 0
                                        identifier = main
                                        disallowed {
                                            CType = pfadfinden_headearslider, pfadfinden_headerblock
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                icon = EXT:bdp_template/Resources/Public/Icons/BackendLayouts/headerWithOneColumn.png
            }
        }
    }
}
